<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:name=".OpenTimeManagerApplication" android:label="@string/app_name" android:allowBackup="false" android:supportsRtl="true">
        <service android:name=".system.TrackingService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-initiated work-time tracking with persistent notification controls to pause, resume or stop the current work session." />
        </service>
        <receiver android:name=".system.TrackingCommandReceiver" android:exported="false" />
        <service android:name=".system.TrackingTileService" android:label="@string/app_name" android:icon="@drawable/ic_tracking" android:exported="true" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>
        <receiver android:name=".widget.TrackingWidgetProvider" android:label="@string/app_name" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/tracking_widget_info" />
        </receiver>
    </application>
</manifest>
